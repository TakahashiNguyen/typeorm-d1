{
  "name": "typeorm-d1",
  "version": "1.0.0",
  "description": "TypeORM DataSource adapter for Cloudflare D1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ISSUES.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "verify:package": "npm run build && node scripts/verify-package.cjs",
    "verify": "npm run build && npm test && npm run verify:package"
  },
  "keywords": [
    "typeorm",
    "cloudflare",
    "d1",
    "sqlite",
    "orm",
    "driver"
  ],
  "author": "typeorm-d1 contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edulelis/typeorm-d1.git"
  },
  "bugs": {
    "url": "https://github.com/edulelis/typeorm-d1/issues"
  },
  "homepage": "https://github.com/edulelis/typeorm-d1#readme",
  "peerDependencies": {
    "reflect-metadata": "^0.2.2",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@swc/core": "^1.15.46",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "26.1.2",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "miniflare": "^4.20260722.1",
    "prettier": "^3.9.6",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-jsdoc": "^1.8.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "semantic-release": "25.0.8",
    "ts-jest": "^29.4.12",
    "tsup": "8.5.1",
    "typeorm": "1.1.0",
    "typescript": "^5.9.3"
  }
}
